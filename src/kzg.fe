use core::Option
use keccak::ByteSource
use ingot::bls_curve::{Affine, ORDER, Point, decompress_g1, g1_generator, multiply_two}
use ingot::bls_field::{Field, Fp}
use ingot::bls_pairing::{final_exponentiation, miller_loop_lines}
use ingot::kzg_lines::{NEG_G2_LINES, TAU_G2_LINES}

/// KZG commitments and proofs: the encoded identity, or a valid compressed
/// point in the prime-order subgroup (validate_kzg_g1 and KeyValidate).
pub fn decode_kzg_g1<T: ByteSource>(_ source: T, offset: usize) -> Option<Affine<Fp>> {
    let point = match decompress_g1(source, offset) {
        Option::Some(point) => point,
        Option::None => return Option::None,
    }
    if !point.infinity && !Point::from_affine(point).in_subgroup() { return Option::None }
    Option::Some(point)
}

/// Whether `proof` shows that the polynomial committed to by `commitment`
/// evaluates to y at z (verify_kzg_proof_impl in the consensus specs), for the
/// mainnet trusted setup; false when z or y is not below the scalar field
/// order. e(C - [y]G1, -G2) * e(proof, [tau]G2 - [z]G2) == 1 is computed as
/// e(C - [y]G1 + [z]proof, -G2) * e(proof, [tau]G2) == 1, since
/// e(proof, [-z]G2) = e([z]proof, -G2), which leaves both G2 points constant,
/// so their Miller loop lines are precomputed.
pub fn verify_proof(commitment: Affine<Fp>, z: u256, y: u256, proof: Affine<Fp>) -> bool {
    if z >= ORDER || y >= ORDER { return false }
    let generator = Affine { x: g1_generator().x, y: g1_generator().y, infinity: false }
    let combined = multiply_two(generator.neg(), y, proof, z).add_affine(commitment).to_affine()
    final_exponentiation(miller_loop_lines(combined, NEG_G2_LINES, proof, TAU_G2_LINES)).is_one()
}
