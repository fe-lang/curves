use core::MemArray
use ingot::bls_curve::{Affine, ORDER, Point, g1_generator, g2_generator, msm, multiply_two, on_g1, on_g2}
use ingot::bls_field::{Field, Fp}
use ingot::bls_tower::Fp2

#[test]
fn bls_subgroup_checks_match_multiplication_by_the_order() {
    let g1 = g1_generator()
    let g2 = g2_generator()
    for p in [g1, g1.double(), g1.multiply(0x1234567890abcdef).neg(), Point<Fp>::identity()] {
        core::assert(p.in_subgroup() && p.multiply(ORDER).is_identity())
    }
    for q in [g2, g2.double(), g2.multiply(0x1234567890abcdef).neg(), Point<Fp2>::identity()] {
        core::assert(q.in_subgroup() && q.multiply(ORDER).is_identity())
    }
    // Points of the curves outside the subgroups, at x = 4 and x = 1 + u.
    let x1 = Fp::from_canonical([4, 0, 0, 0, 0, 0])
    let y1 = x1.square().mul(x1).add(Fp::from_canonical([4, 0, 0, 0, 0, 0])).sqrt().unwrap()
    core::assert(on_g1(x: x1, y: y1))
    let p = Point { x: x1, y: y1, z: Fp::one() }
    core::assert(!p.in_subgroup() && !p.multiply(ORDER).is_identity())
    core::assert(!p.add(g1).in_subgroup() && !p.multiply(5).in_subgroup())
    let one = Fp::one()
    let x2 = Fp2::new(c0: one, c1: one)
    let four = Fp::from_canonical([4, 0, 0, 0, 0, 0])
    let y2 = x2.square().mul(x2).add(Fp2::new(c0: four, c1: four)).sqrt().unwrap()
    core::assert(on_g2(x: x2, y: y2))
    let q = Point { x: x2, y: y2, z: Fp2::one() }
    core::assert(!q.in_subgroup() && !q.multiply(ORDER).is_identity())
    core::assert(!q.add(g2).in_subgroup() && !q.multiply(5).in_subgroup())
}

// The sum `msm` gives for k multiples of `generator`, one of them the
// identity, and the sum of their separate multiplications.
fn msm_and_expected<F: Field + Copy>(_ generator: Point<F>, k: usize) -> (Point<F>, Point<F>) {
    let scalars: [u256; 8] = [
        0, 1, ORDER - 1, ORDER + 5, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
        0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef, 1 << 254, 0xd201000000010000,
    ]
    var points = MemArray::try_from_fn(k, |_| Affine<F>::identity()).unwrap()
    var reduced = MemArray<u256>::try_new_zeroed(k).unwrap()
    var expected = Point<F>::identity()
    for i in 0..k {
        let point = if i == 4 { Point<F>::identity() } else { generator.multiply(i as u256 * 7 + 3) }
        let scalar = (scalars[i % 8] ^ (i / 8) as u256) % ORDER
        points[i] = point.to_affine()
        reduced[i] = scalar
        expected = expected.add(point.multiply(scalar))
    }
    (msm(points, reduced).unwrap(), expected)
}

#[test]
fn bls_msm_matches_separate_multiplications() {
    // Below and above the size where Pippenger's method takes over.
    for k in [3 as usize, 9, 40] {
        let (sum, expected) = msm_and_expected(g1_generator(), k)
        core::assert(sum.equals(expected))
    }
    for k in [3 as usize, 12] {
        let (sum, expected) = msm_and_expected(g2_generator(), k)
        core::assert(sum.equals(expected))
    }
}

#[test]
fn bls_multiply_two_matches_separate_multiplications() {
    let g = g1_generator()
    let a = g.multiply(0x1234567890abcdef).to_affine()
    let b = g.double().add(g).to_affine()
    let large = ORDER - 1
    for (p, q) in [(a, b), (a, Affine<Fp>::identity()), (b, b.neg()), (a, a)] {
        for (s, t) in [(0, 0), (1, 0), (0, 1), (large, large), (large - 0x5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a, 0xd201000000010000 * 0xd201000000010000 + 7)] {
            core::assert(multiply_two(p, s, q, t).equals(p.multiply(s).add(q.multiply(t))))
        }
    }
}
