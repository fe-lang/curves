    [0x6569345eb41ed76e, 0xa1a534757df374dd, 0xad397c1837a90f0e, 0xc4fb4c39325d3164, 0x7f367e7242250427, 0x00cc12449be6ac4e],
]
const ORDER_13_X: [[u64; 6]; 2] = [
    [0x56905843518bc0c2, 0x6bae16f9f2763ab5, 0x34d320e323d9fcc7, 0xffeef5b14a3e2468, 0x8340a1a548d700c5, 0x043ff79d06a80add],
    [0xee69a68b7d4704a4, 0x278c22ea15e6d03c, 0x0a23c05406588284, 0x09b25206fa89dded, 0x7d4ebc6409c2fdae, 0x032762e5199990da],
]
const ORDER_13_Y: [[u64; 6]; 2] = [
    [0x4501e53fabc600f3, 0x67961c8d7bcc69b9, 0xb6502cc324ab0479, 0x0f05b83418b3d3b6, 0x916f6195da10e94d, 0x07b8eb3b0d94f08c],
    [0x7eb47d01649f4c1e, 0x0a516e85dc3f7497, 0x1192186219d8d38a, 0xfefcf24fd6b08089, 0x02d3dda394c1dd5f, 0x082b2fb28bdddaf7],
]
const S: u256 = 0x5a3c1f0e2d4b69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0
const MAX_G1_X: [u64; 6] = [0xa4f0564050d31746, 0x0ada1a51bc7a4006, 0x627c30c34252679a, 0x4c1df37194d30803, 0x89479129b258960b, 0x16ea601ca88f7d34]
const MAX_G1_Y: [u64; 6] = [0xc8f2655fad5e2013, 0x10fba8f436aec3a3, 0xca518d1bedb573e3, 0xd2aa8e0c4a1ffbe9, 0xf27bf38f950b2af8, 0x039e394a6f95c4a2]
const S_G1_X: [u64; 6] = [0x73d1c1879451d491, 0xdb47cba30484cc68, 0x8a688a56fc085514, 0x583a25cce07bf919, 0xfd3a001e36831ace, 0x05844e87c85eea73]
const S_G1_Y: [u64; 6] = [0xfea7ffcdc4c119dc, 0x09d6cbe95230459e, 0x9b8fa3c0b7898e21, 0xf4e0a88062a205d0, 0xf2b32f7870a7d268, 0x0c2b4494357f0495]
const MAX_P4_X: [u64; 6] = [0xf2227b653813cb65, 0x6a1eb8e74c85fe01, 0x524954c911e9b5a1, 0x6d52e9dc3bf87ded, 0x67dae9736ea0f74e, 0x01162780d4319fed]
const MAX_P4_Y: [u64; 6] = [0xbed5440cfff386f9, 0x5ac03b7bb987ca83, 0xaac5c55f73611759, 0x19bd12559aff18e8, 0x4fa0485464f07a81, 0x0c82de2e1459ae1f]
const MAX_G2_X: [[u64; 6]; 2] = [
